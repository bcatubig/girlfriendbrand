---
import "@styles/starwind.css";
// src/pages/product/[slug].astro
// Product page w/ image gallery (thumbnails + main image), Tailwind-only.
// Works without JS; add tiny JS below for nicer UX (still optional).

// Example product data — replace with your own loader (content collection, CMS, etc.)
const product = {
  name: "Heavyweight Selvedge Denim",
  brand: "Local Label",
  price: 265,
  description:
    "14.5oz selvedge denim woven for everyday wear. Classic rise, clean taper, sturdy hardware.",
  details: [
    "14.5oz selvedge denim",
    "Sanforized (minimal shrink)",
    "Chain-stitched hems",
    "Made locally in small batches",
  ],
  images: [
    {
      src: "https://images.unsplash.com/photo-1520975916090-3105956dac38?auto=format&fit=crop&w=1600&q=80",
      alt: "Front view on-body",
    },
    {
      src: "https://images.unsplash.com/photo-1520975741248-8b6fa1b1a9ab?auto=format&fit=crop&w=1600&q=80",
      alt: "Fabric detail",
    },
    {
      src: "https://images.unsplash.com/photo-1452860606245-08befc0ff44b?auto=format&fit=crop&w=1600&q=80",
      alt: "Construction detail",
    },
    {
      src: "https://images.unsplash.com/photo-1521337581100-8ca9a73a5f79?auto=format&fit=crop&w=1600&q=80",
      alt: "Back view",
    },
  ],
  sizes: ["28", "29", "30", "31", "32", "33", "34", "36"],
};
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{product.name} — {product.brand}</title>
  </head>

  <body class="bg-white text-neutral-900 antialiased">
    <!-- Minimal header -->
    <header class="border-b border-neutral-200">
      <div
        class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4"
      >
        <a href="/" class="text-sm font-semibold tracking-[0.25em] uppercase"
          >Local Label</a
        >
        <nav
          class="flex items-center gap-5 text-xs tracking-[0.2em] text-neutral-700 uppercase"
        >
          <a href="/#shop" class="hover:text-neutral-950">Shop</a>
          <a href="/#journal" class="hover:text-neutral-950">Journal</a>
          <a href="/#stores" class="hover:text-neutral-950">Stores</a>
          <a href="/#contact" class="hover:text-neutral-950">Contact</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-8 md:py-12">
      <!-- Breadcrumb -->
      <div class="mb-6 text-xs tracking-[0.2em] text-neutral-600 uppercase">
        <a href="/" class="hover:text-neutral-900">Home</a>
        <span class="px-2 text-neutral-400">/</span>
        <a href="/#shop" class="hover:text-neutral-900">Shop</a>
        <span class="px-2 text-neutral-400">/</span>
        <span class="text-neutral-900">{product.name}</span>
      </div>

      <div class="grid gap-10 lg:grid-cols-2">
        <!-- Gallery -->
        <section class="min-w-0">
          <!-- Main image frame -->
          <div
            class="overflow-hidden rounded-2xl border border-neutral-200 bg-neutral-50"
          >
            <img
              id="mainImage"
              src={product.images[0].src}
              alt={product.images[0].alt}
              class="aspect-[4/5] w-full object-cover"
              loading="eager"
            />
          </div>

          <!-- Thumbnails -->
          <div class="mt-4 grid grid-cols-4 gap-3">
            {
              product.images.map((img, idx) => (
                <button
                  type="button"
                  class={`group overflow-hidden rounded-xl border bg-white focus:ring-2 focus:ring-neutral-300 focus:outline-none ${
                    idx === 0
                      ? "border-neutral-900"
                      : "border-neutral-200 hover:border-neutral-300"
                  }`}
                  data-thumb
                  data-src={img.src}
                  data-alt={img.alt}
                  aria-label={`View image ${idx + 1}`}
                >
                  <img
                    src={img.src}
                    alt={img.alt}
                    class="aspect-square w-full object-cover transition duration-300 group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </button>
              ))
            }
          </div>

          <!-- Optional: small caption -->
          <p id="caption" class="mt-3 text-sm text-neutral-700">
            {product.images[0].alt}
          </p>
        </section>

        <!-- Product info -->
        <section class="min-w-0">
          <p class="text-xs tracking-[0.22em] text-neutral-600 uppercase">
            {product.brand}
          </p>
          <h1 class="mt-2 text-3xl font-semibold tracking-tight md:text-4xl">
            {product.name}
          </h1>

          <p class="mt-3 text-lg text-neutral-900">${product.price}</p>

          <!-- Purchase box -->
          <div class="mt-6 rounded-2xl border border-neutral-200 bg-white p-5">
            <div class="flex items-center justify-between">
              <p
                class="text-xs font-semibold tracking-[0.22em] text-neutral-600 uppercase"
              >
                Size
              </p>
              <a
                href="#sizing"
                class="text-xs tracking-[0.18em] text-neutral-700 uppercase underline-offset-4 hover:text-neutral-950 hover:underline"
              >
                Sizing
              </a>
            </div>

            <!-- Sizes -->
            <div class="mt-3 grid grid-cols-4 gap-2">
              {
                product.sizes.map((s) => (
                  <button
                    type="button"
                    class="rounded-xl border border-neutral-200 px-3 py-2 text-sm text-neutral-900 hover:border-neutral-300 focus:ring-2 focus:ring-neutral-300 focus:outline-none"
                    data-size
                  >
                    {s}
                  </button>
                ))
              }
            </div>

            <div class="mt-4 flex flex-col gap-3 sm:flex-row">
              <button
                type="button"
                class="inline-flex w-full items-center justify-center rounded-xl bg-neutral-900 px-5 py-3 text-xs font-semibold tracking-[0.2em] text-white uppercase hover:bg-neutral-800"
              >
                Add to cart
              </button>
              <button
                type="button"
                class="inline-flex w-full items-center justify-center rounded-xl border border-neutral-200 bg-white px-5 py-3 text-xs font-semibold tracking-[0.2em] text-neutral-900 uppercase hover:bg-neutral-50"
              >
                Favorite
              </button>
            </div>

            <p class="mt-3 text-xs text-neutral-600">
              In stock · Free local pickup available
            </p>
          </div>

          <!-- Description -->
          <div class="mt-8">
            <h2
              class="text-xs font-semibold tracking-[0.28em] text-neutral-600 uppercase"
            >
              Description
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">
              {product.description}
            </p>
          </div>

          <!-- Details -->
          <div class="mt-8">
            <h2
              class="text-xs font-semibold tracking-[0.28em] text-neutral-600 uppercase"
            >
              Details
            </h2>
            <ul class="mt-3 space-y-2 text-sm text-neutral-700">
              {
                product.details.map((d) => (
                  <li class="flex gap-2">
                    <span class="mt-[0.35rem] h-1.5 w-1.5 shrink-0 rounded-full bg-neutral-300" />
                    <span>{d}</span>
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Sizing (anchor target) -->
          <div
            id="sizing"
            class="mt-10 rounded-2xl border border-neutral-200 bg-neutral-50 p-5"
          >
            <h2
              class="text-xs font-semibold tracking-[0.28em] text-neutral-600 uppercase"
            >
              Sizing
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">
              True to size. If between sizes, size up. Want help? Email us with
              your usual waist size and preferred fit.
            </p>
          </div>
        </section>
      </div>
    </main>

    <footer class="border-t border-neutral-200">
      <div class="mx-auto max-w-6xl px-4 py-10 text-xs text-neutral-600">
        © {new Date().getFullYear()} Local Label
      </div>
    </footer>

    <!-- Tiny JS to swap main image when a thumbnail is clicked -->
    <script is:inline>
      const main = document.getElementById("mainImage");
      const cap = document.getElementById("caption");
      const thumbs = document.querySelectorAll("[data-thumb]");

      thumbs.forEach((btn) => {
        btn.addEventListener("click", () => {
          const src = btn.getAttribute("data-src");
          const alt = btn.getAttribute("data-alt") || "";
          if (!src || !main) return;

          main.src = src;
          main.alt = alt;
          if (cap) cap.textContent = alt;

          // visual selected state
          thumbs.forEach((b) => b.classList.remove("border-neutral-900"));
          thumbs.forEach((b) => b.classList.add("border-neutral-200"));
          btn.classList.add("border-neutral-900");
          btn.classList.remove("border-neutral-200");
        });
      });
    </script>
  </body>
</html>
